# คัดลอกไฟล์นี้เป็น backend/.env แล้วแก้เฉพาะที่ต้องการ (cp .env.example .env)
# ไม่แก้อะไรเลยก็รันในเครื่องได้ทันที: ใช้ฐานข้อมูล SQLite ในเครื่อง และไม่ส่ง LINE จริง
# บน Render ให้ตั้งค่าเหล่านี้ที่ Environment ของบริการ (ไฟล์ .env ไม่ถูก commit ขึ้น GitHub) ดู docs/06_DEPLOYMENT.md

# --- ทั่วไป ---
ENVIRONMENT=development
# โดเมนของเว็บฝั่งลูกค้าที่เรียก API ได้ คั่นด้วยจุลภาค (ตอน deploy ใส่ URL ของ Vercel)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ฐานข้อมูล ---
# ปล่อยไว้ = SQLite ในเครื่อง ตอน deploy ใส่ connection string ของ Supabase (docs/02_DATABASE_SUPABASE.md)
DATABASE_URL=sqlite:///./nailglow.db

# --- Supabase Storage (เก็บรูป) ไม่ใส่ = เก็บรูปในโฟลเดอร์ backend/static/uploads ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ความปลอดภัย: ตอน deploy จริงต้องเปลี่ยนทั้งสามค่านี้ ห้ามใช้ค่าตัวอย่าง ---
JWT_SECRET=change-this-secret-in-production
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=changeme123

# --- LINE Official Account (docs/05_LINE_INTEGRATION.md) ไม่ใส่ = ข้ามการส่ง LINE ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# วลีลับที่คนในร้านพิมพ์ทักแชท OA เพื่อรับแจ้งเตือนคิวใหม่ ตั้งเป็นของตัวเอง ห้ามใช้ค่า default
SHOP_OWNER_LINK_PHRASE=ผูกไลน์เจ้าของร้าน

# --- ตัวกันกดถี่หลัง proxy (ปกติไม่ต้องตั้ง ดู docs/06_DEPLOYMENT.md หัวข้อ "ตัวกันกดถี่") ---
# TRUSTED_PROXY_HOPS=0

# --- AI ---
# false = ไม่โหลดโมเดลตรวจเล็บล่วงหน้าตอนเริ่มเซิร์ฟเวอร์ (ชุดทดสอบใช้ค่านี้)
# AI_WARM_UP=true
